# API base URL — replace with your backend's address
# For dev: use your Mac/PC's LAN IP (NOT localhost — phones can't reach localhost)
# Backend Spring Boot runs on port 8089 by default (no /api suffix in URL)
# Example:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8089       # WiFi LAN
#   EXPO_PUBLIC_API_URL=http://172.20.10.2:8089        # iPhone hotspot
#   EXPO_PUBLIC_API_URL=http://100.X.X.X:8089          # Tailscale
EXPO_PUBLIC_API_URL=http://localhost:8089
